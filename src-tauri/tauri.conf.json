{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Session Manager",
  "version": "0.3.4",
  "identifier": "com.local.opencodesessionmanager",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "OpenCode Session Manager",
      "width": 1280,
      "height": 820,
      "minWidth": 900,
      "minHeight": 600,
      "decorations": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": [] }
}
